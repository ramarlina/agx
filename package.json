{
  "name": "@mndrk/agx",
  "version": "2.3.2",
  "description": "Autonomous AI Agent Orchestrator for Claude, Gemini, and Ollama",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/local",
    "apps/desktop"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cli": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "agx": "./index.js"
  },
  "files": [
    "index.js",
    "lib/**",
    "commands/**",
    "templates/**",
    "cloud-runtime/**",
    "skills/**",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "preinstall": "node -e \"var v=process.versions.node.split('.').map(Number);if(v[0]<22||(v[0]===22&&v[1]<16)){console.error('agx requires Node.js >= 22.16.0 (found '+process.version+'). node:sqlite is not available on older versions.');process.exit(1)}\"",
    "postinstall": "node ./scripts/postinstall.js || true",
    "prepack": "node ./scripts/package-board-runtime.js",
    "board:bundle": "node ./scripts/package-board-runtime.js",
    "local:dev": "npm run dev --workspace apps/local",
    "local:build": "npm run build --workspace apps/local",
    "local:test": "npm run test --workspace apps/local",
    "local:e2e": "npm run test:e2e --workspace apps/local",
    "desktop:dev": "npm run dev --workspace apps/desktop",
    "desktop:pack": "npm run pack --workspace apps/desktop",
    "desktop:build": "npm run build --workspace apps/desktop",
    "desktop:build:mac": "npm run build:mac --workspace apps/desktop",
    "test": "node --localstorage-file=/tmp/agx-jest-localstorage ./node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --localstorage-file=/tmp/agx-jest-localstorage ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --localstorage-file=/tmp/agx-jest-localstorage ./node_modules/jest/bin/jest.js --coverage --forceExit",
    "test:unit": "node --localstorage-file=/tmp/agx-jest-localstorage ./node_modules/jest/bin/jest.js --testPathIgnorePatterns=integration --forceExit",
    "test:integration": "node --localstorage-file=/tmp/agx-jest-localstorage ./node_modules/jest/bin/jest.js --testPathPattern=integration --forceExit",
    "test:all": "node --localstorage-file=/tmp/agx-jest-localstorage ./node_modules/jest/bin/jest.js --coverage --forceExit"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "gemini",
    "claude",
    "ollama",
    "llm",
    "cloud"
  ],
  "author": "Mendrika Ramarlina",
  "license": "MIT",
  "homepage": "https://runagx.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramarlina/agx"
  },
  "bugs": {
    "url": "https://github.com/ramarlina/agx/issues"
  },
  "dependencies": {
    "eventsource": "^4.1.0",
    "execa": "^5.1.1",
    "lucide-react": "^1.8.0",
    "p-map": "^7.0.4",
    "p-retry": "^7.1.1",
    "posthog-node": "^4.18.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0"
  }
}
