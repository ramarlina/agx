# Apple Developer credentials for code signing and notarization

# Option A: App Store Connect API key (recommended)
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=

# Option B: Apple ID and app-specific password
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Code signing certificate identity or .p12 path
CSC_NAME=
CSC_LINK=
CSC_KEY_PASSWORD=
