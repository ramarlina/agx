# SQLite local state (optional overrides)
# AGX_DATA_DIR=$HOME/.agx
# SQLITE_DB_PATH=$HOME/.agx/agx-board.db

# Local AGX app mode (auth disabled)
AGX_BOARD_DISABLE_AUTH=1
NEXT_PUBLIC_AGX_BOARD_DISABLE_AUTH=1
NEXT_PUBLIC_AGX_BOARD_URL=http://localhost:41741
AGX_BOARD_USER_ID=00000000-0000-0000-0000-000000000001
AGX_BOARD_USER_EMAIL=local@agx.board
AGX_BOARD_USER_NAME=Local Board User

# Optional provider auth
# ZAI_API_KEY=your-z-ai-api-key

# App URL (for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:41741

# Security: Salt for daemon secret hashing (generate with: openssl rand -hex 32)
SECRET_SALT=your-random-salt-here

# Operational limits (see docs/LIMITS.md)
# NEXT_PUBLIC_AGX_MAX_WORKERS=10
