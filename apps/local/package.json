{
  "name": "@mndrk/agx-local-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "nuke": "lsof -ti :41741 | xargs kill -9 2>/dev/null; pkill -9 -f 'apps/local' 2>/dev/null; echo 'All processes killed'",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "test": "node --localstorage-file=/tmp/agx-local-jest-localstorage ./node_modules/jest/bin/jest.js",
    "test:watch": "node --localstorage-file=/tmp/agx-local-jest-localstorage ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --localstorage-file=/tmp/agx-local-jest-localstorage ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:sandbox": "SANDBOX=1 CLOUD_SYNC_DISABLED=1 E2E_HOST=127.0.0.1 E2E_PORT=3100 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:e2e",
    "ci:test": "node --localstorage-file=/tmp/agx-local-jest-localstorage ./node_modules/jest/bin/jest.js --coverage && playwright test --reporter=github",
    "worker": "tsx worker/index.ts",
    "daemon:worker": "npm run worker",
    "daemon:temporal": "npm run worker",
    "backfill:automations": "tsx scripts/backfill-automations-frontmatter.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@dagrejs/graphlib": "^3.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iarna/toml": "^2.2.5",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.86",
    "cel-js": "^0.8.2",
    "cron-parser": "^5.5.0",
    "diff": "^8.0.3",
    "dotenv": "^17.3.1",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0",
    "use-debounce": "^10.1.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "xstate": "^5.28.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@xstate/graph": "^3.0.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "fast-check": "^4.5.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "next-router-mock": "^1.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
}
